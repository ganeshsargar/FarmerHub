<% layout('/layouts/boilerplate') -%>

    <!-- <h3 class="mt-3">All Works Post</h3> -->
    <!-- <form action="/listings/new" method="get">
        <button>Create New Post</button>
    </form> -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-4" >
        <% for(listing of allListings) { %>
            <a class="listing-link" href="/listings/<%= listing._id %>">
                <div class="card col listing-card" >
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing-image" style="height: 20rem">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                      <b><p class="card-text"><%= listing.title %> <br/>
                      </p></b>
                        <p>&#8377;<%= listing.price.toLocaleString("en-IN")%> / day</p>
                       
                    </div>
                </div>
            </a>
            
        <% } %>
    </div>


